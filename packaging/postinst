#!/bin/sh
# Register the companion launcher app so LaunchServices knows it owns the
# "volumemixer://" URL scheme (otherwise Shortcuts' "Open URL" still reports
# the scheme as having no host app). Works under rootless / roothide where the
# jailbreak root is /var/jb (or $JBROOT).
set -e

JBBROOT="${JBROOT:-/var/jb}"
APP="$JBBROOT/Applications/VolumeMixerLauncher.app"
LSREG="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

if [ -d "$APP" ] && [ -x "$LSREG" ]; then
	"$LSREG" -f "$APP" || true
fi

exit 0
