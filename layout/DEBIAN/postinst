#!/bin/sh
# Register the companion launcher app so LaunchServices knows it owns the
# "volumemixer://" URL scheme (otherwise Shortcuts' "Open URL" still reports
# the scheme as having no host app).
#
# roothide installs under a randomized jailbreak root, so /var/jb is not always
# the real path. Ask dpkg where the app actually landed; fall back to the common
# prefixes.
set -e

LSREG="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister"

APP=""

# Preferred: the exact path dpkg recorded for this package.
if command -v dpkg >/dev/null 2>&1; then
	APP="$(dpkg -L com.brend0n.volumemixer 2>/dev/null | grep -m1 'VolumeMixerLauncher.app$' || true)"
fi

# Fallbacks: JBROOT env (roothide), the rootless prefix.
if [ -z "$APP" ] || [ ! -d "$APP" ]; then
	for ROOT in "${JBROOT:-}" /var/jb /private/var/jb; do
		[ -z "$ROOT" ] && continue
		if [ -d "$ROOT/Applications/VolumeMixerLauncher.app" ]; then
			APP="$ROOT/Applications/VolumeMixerLauncher.app"
			break
		fi
	done
fi

if [ -n "$APP" ] && [ -d "$APP" ] && [ -x "$LSREG" ]; then
	"$LSREG" -f "$APP" || true
fi

exit 0
